{
  "name": "pybot-weights",
  "private": true,
  "type": "module",
  "scripts": {
    "learn":        "bun run src/learn.ts",
    "infer":        "bun run src/infer.ts",
    "eval":         "bun run src/eval.ts",
    "check":        "bun run src/check.ts",
    "typecheck":    "tsc --noEmit -p .",
    "lint":         "eslint .",
    "lint:fix":     "eslint . --fix",
    "format":       "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js":             "9.14.0",
    "@types/bun":             "1.3.1",
    "eslint":                 "9.14.0",
    "eslint-config-prettier": "9.1.0",
    "globals":                "15.12.0",
    "prettier":               "3.3.3",
    "typescript":             "5.6.3",
    "typescript-eslint":      "8.13.0"
  }
}
